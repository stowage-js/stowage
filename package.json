{
  "name": "stowage-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:floors": "vitest run --config harness/floors/vitest.config.ts",
    "test:bun": "pnpm --filter @stowage/harness-bun test",
    "test:deno": "pnpm --filter @stowage/harness-deno test",
    "test:workerd": "pnpm --filter @stowage/harness-workerd test",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/newest-versions.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "fastify": "5.12.5",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "publint": "0.3.25",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.9.1"
}
