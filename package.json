{
  "name": "stowage-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:floors": "vitest run --config harness/floors/vitest.config.ts",
    "test:bun": "pnpm --filter @stowage/harness-bun test",
    "test:deno": "pnpm --filter @stowage/harness-deno test",
    "test:workerd": "pnpm --filter @stowage/harness-workerd test",
    "test:quickstart": "node scripts/quickstart.ts",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/newest-versions.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "fastify": "5.12.7",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "publint": "0.3.25",
    "tsdown": "0.23.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.11.2"
}
