{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts"],
  // The tests read the package's sources through `node:fs`, and the package itself reaches
  // no Node API (spec 1). The repository's own config checks the tests with Node's types;
  // this one keeps them away from the sources.
  "exclude": ["src/**/*.test.ts"]
}
