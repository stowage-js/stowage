{
  "name": "@stowage/nextjs",
  "version": "0.4.0",
  "description": "The Next.js integration of stowage: builds a storage on its first use, so that next build constructs none, for route handlers that answer through @stowage/http.",
  "keywords": [
    "next",
    "nextjs",
    "object-storage",
    "route-handler",
    "storage",
    "stowage"
  ],
  "homepage": "https://github.com/stowage-js/stowage/tree/main/packages/nextjs#readme",
  "bugs": "https://github.com/stowage-js/stowage/issues",
  "license": "MIT",
  "author": "Alexander Kaufmann",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stowage-js/stowage.git",
    "directory": "packages/nextjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@stowage/core": "workspace:^"
  },
  "devDependencies": {
    "@stowage/adapter-memory": "workspace:^",
    "@stowage/adapter-s3": "workspace:^",
    "@stowage/http": "workspace:^",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "peerDependencies": {
    "next": "^16.3.8"
  },
  "engines": {
    "node": ">=24"
  }
}
