{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "es2024",
    "lib": ["ES2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "isolatedDeclarations": true,
    "resolveJsonModule": true,

    // A relative import carries `.ts`, which is what `node --experimental-strip-types`
    // needs to run a source file with no build in front of it (ADR 0008).
    "allowImportingTsExtensions": true,

    "declaration": true,
    "noEmit": true,
    "skipLibCheck": true
  }
}
